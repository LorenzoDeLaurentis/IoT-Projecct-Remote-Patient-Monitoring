        "name": "Live Calendar",
        "order": 1,
        "width": "6",
        "height": "13",
        "head": "",
        "format": "<div style=\"width: 100%; height: 600px; margin: 0 auto;\">\n    <div id='dashboard-calendar' style=\"height: 100%;\"></div>\n</div>\n\n<!-- Load FullCalendar from CDN -->\n<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>\n\n<script>\n    (function() {\n        setTimeout(function() {\n            var calendarEl = document.getElementById('dashboard-calendar');\n            if (calendarEl && !calendarEl.classList.contains('fc')) {\n                var calendar = new FullCalendar.Calendar(calendarEl, {\n                    initialView: 'dayGridMonth',\n                    height: '100%',\n                    headerToolbar: {\n                        left: 'prev,next today',\n                        center: 'title',\n                        right: 'dayGridWeek,dayGridMonth'\n                    },\n                    events: [], // Starts empty, populated dynamically by Node-RED messages\n                    eventTimeFormat: {\n                        hour: '2-digit',\n                        minute: '2-digit',\n                        hour12: false\n                    },\n                    eventClick: function(info) {\n                        var details = info.event.extendedProps;\n                        var message = \"APPOINTMENT DETAILS:\\n\" +\n                                      \"----------------------------------\\n\" +\n                                      \"Patient: \" + details.patient_name + \"\\n\" +\n                                      \"Doctor: \" + details.doctor + \"\\n\" +\n                                      \"Reason: \" + details.reason + \"\\n\" +\n                                      \"Date: \" + details.date + \"\\n\" +\n                                      \"Time: \" + details.time;\n                        alert(message);\n                    }\n                });\n                calendar.render();\n\n                // Listen for incoming messages from Node-RED (HTTP Request payload)\n                scope.$watch('msg', function(msg) {\n                    if (msg && msg.payload) {\n                        // Clear old events and load the new appointment array from database\n                        calendar.removeAllEvents();\n                        var eventsToAdd = Array.isArray(msg.payload) ? msg.payload : [msg.payload];\n                        eventsToAdd.forEach(function(ev) {\n                            calendar.addEvent(ev);\n                        });\n                    }\n                });\n            }\n        }, 300);\n    })();\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
